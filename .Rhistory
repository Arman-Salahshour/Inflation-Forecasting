names(pr)
# Convert the date column type (char) to the (date) type
date_convertor = function (df) {
df |>
mutate(date = ym(date))|>
filter(date >= ym('2006-01') & date <= ym('2026-08'))|>
arrange(date)
}
cpi = date_convertor(cpi)
ue = date_convertor(ue)
exr = date_convertor(exr)
pr = date_convertor(pr)
