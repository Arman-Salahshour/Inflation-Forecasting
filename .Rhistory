y_checks = train[[target]]
n = nrow(x_checks)
folds = ceiling(seq_len(n)/ (n/5))
coef(cv.glmnet(x_checks, y_checks, foldid=folds, alpha=1, s="lambda.min"))
coef(cv.glmnet(x_checks, y_checks, foldid=folds, alpha=1), s="lambda.min")
